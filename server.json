{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-09-29/server.schema.json",
  "name": "io.github.Icaro0310/devin-memory",
  "description": "Anti-poisoning memory for agents: provenance, conflicts, quarantine gate.",
  "version": "0.3.0",
  "repository": {
    "url": "https://github.com/Icaro0310/devin-brain",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "devin-memory-mcp",
      "version": "0.3.1",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "DEVIN_MEMORY_DB",
          "description": "Path to memory.db (default: ./memory.db)",
          "isRequired": false
        }
      ]
    }
  ]
}
